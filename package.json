{
  "name": "wanwu",
  "displayName": "Wanwu",
  "description": "万物 - 多 Agent CLI 启动器与工作区检查点工具",
  "version": "0.0.4",
  "publisher": "wanwu",
  "icon": "src/Wanwu.png",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/wanwu-ai/wanwu.git"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "wanwu.openAgentTerminal",
        "title": "Open Agent Terminal",
        "category": "Wanwu",
        "icon": "src/Wanwu.png"
      },
      {
        "command": "wanwu.openRouterConfig",
        "title": "Open Router Config",
        "category": "Wanwu"
      },
      {
        "command": "wanwu.createCheckpoint",
        "title": "Create Checkpoint",
        "category": "Wanwu"
      },
      {
        "command": "wanwu.restoreCheckpoint",
        "title": "Restore Checkpoint",
        "category": "Wanwu"
      },
      {
        "command": "wanwu.newConversation",
        "title": "New Conversation",
        "category": "Wanwu"
      },
      {
        "command": "wanwu.loadConversation",
        "title": "Load Conversation",
        "category": "Wanwu"
      },
      {
        "command": "wanwu.exportConversation",
        "title": "Export Conversation",
        "category": "Wanwu"
      },
      {
        "command": "wanwu.importConversation",
        "title": "Import Conversation",
        "category": "Wanwu"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "wanwu.openAgentTerminal",
          "when": "true",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "wanwu.openAgentTerminal",
          "when": "true"
        },
        {
          "command": "wanwu.openRouterConfig",
          "when": "true"
        },
        {
          "command": "wanwu.createCheckpoint",
          "when": "true"
        },
        {
          "command": "wanwu.restoreCheckpoint",
          "when": "true"
        },
        {
          "command": "wanwu.newConversation",
          "when": "true"
        },
        {
          "command": "wanwu.loadConversation",
          "when": "true"
        },
        {
          "command": "wanwu.exportConversation",
          "when": "true"
        },
        {
          "command": "wanwu.importConversation",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "Wanwu",
      "properties": {
        "wanwu.agents": {
          "type": "array",
          "scope": "machine",
          "default": [
            {
              "label": "Claude",
              "command": "claude"
            },
            {
              "label": "Codex",
              "command": "codex"
            },
            {
              "label": "Pi",
              "command": "pi"
            },
            {
              "label": "OpenCode",
              "command": "opencode"
            },
            {
              "label": "Qoder",
              "command": "qodercli"
            }
          ],
          "markdownDescription": "点击编辑器标题栏的 Wanwu 图标后可选择的 Agent CLI 列表。`command` 可以是完整命令行，例如 `aider --model gpt-4` 或 `npm run dev`。",
          "items": {
            "type": "object",
            "required": [
              "label",
              "command"
            ],
            "properties": {
              "label": {
                "type": "string",
                "description": "在 QuickPick 和终端标题中显示的名称"
              },
              "command": {
                "type": "string",
                "description": "在终端中执行的完整命令"
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "npx vsce package",
    "publish": "npx vsce publish"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/test-electron": "^2.2.0",
    "eslint": "^8.28.0",
    "mocha": "^10.1.0",
    "typescript": "^4.9.4"
  }
}
